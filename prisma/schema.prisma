generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  displayName  String
  passwordHash String
  avatarId     String   @default("sprout")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
