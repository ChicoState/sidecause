{
  "name": "sidecause",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.8.2 <27",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:e2e": "playwright test",
    "coverage": "vitest run --coverage --passWithNoTests",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "docker:up": "docker compose up -d postgres minio",
    "docker:down": "docker compose down",
    "test:smoke": "bash scripts/smoke.sh",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run coverage"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.8",
    "prisma": "^7.10.0",
    "testcontainers": "^11.14.0",
    "typescript": "5.9",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "cpu-features@0.0.10": true,
    "prisma@7.10.0": true,
    "protobufjs@7.6.6": true,
    "ssh2@1.17.0": true,
    "unrs-resolver@1.12.2": true,
    "@prisma/engines@7.10.0": true
  }
}
