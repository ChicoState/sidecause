# Local PostgreSQL, supplied by `docker compose up -d postgres minio`.
DATABASE_URL="postgresql://sidecause:sidecause@localhost:5432/sidecause?schema=public"

# Local S3-compatible object storage, supplied by AIStor.
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="sidecause"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"

# Replace before implementing authentication; never commit a real session secret.
AUTH_SECRET="replace-with-a-local-development-secret"
